{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.invalid/agent-workflow/task-contract.schema.json",
  "title": "Agent workflow task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "revision",
    "objective",
    "repository",
    "worktree",
    "scope",
    "modelPolicy",
    "toolPolicy",
    "acceptanceCriteria",
    "budgets",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "baseRef"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "baseRef": { "type": "string", "minLength": 1 }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writablePaths", "protectedPaths"],
      "properties": {
        "writablePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "protectedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedFamilies", "allowAutomaticFallback"],
      "properties": {
        "allowedFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["openai", "gemini"] }
        },
        "allowedModelIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "default": [] },
        "allowAutomaticFallback": { "const": false }
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedExecutables", "allowNetwork"],
      "properties": {
        "allowedExecutables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowNetwork": { "const": false }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$" },
          "description": { "type": "string", "minLength": 1 },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executable", "arguments", "timeoutSeconds"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "arguments": { "type": "array", "items": { "type": "string" } },
              "workingDirectory": { "type": "string", "default": "." },
              "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsedMinutes", "retryLimit", "reviewCycles"],
      "properties": {
        "elapsedMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "retryLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "reviewCycles": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": { "required": { "type": "boolean" } }
    }
  }
}
